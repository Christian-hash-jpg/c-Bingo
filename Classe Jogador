Código classe Jogador

using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Trabalho_Bingo
{
    internal class Jogador
    {
        private string nome;
        private int idade;
        private string sexo;
        private int total_Cartelas;
        private Cartelas[] cartelas;

        public Jogador(string nome, int idade, string sexo, int total_Cartelas)
        {
            this.nome = nome;
            this.idade = idade;
            this.sexo = sexo;
            this.total_Cartelas = total_Cartelas;
            cartelas = new Cartelas[total_Cartelas];
        }

        public string Nome
        {
            get { return nome; }
            set { this.nome = value; }
        }

        public int Idade
        {
            get { return idade; }
            set { this.idade = value; }
        }

        public string Sexo
        {
            get { return sexo; }
            set { this.sexo = value; }
        }

        public int Total_Cartelas
        {
            get { return total_Cartelas; }
            set { total_Cartelas = value; }
        }

        public Cartelas[] Cartelas
        {
            get { return cartelas; }
            set { cartelas = value; }
        }

        public void AdicionarCartela(Cartelas c)
        {
            bool adicionou = false;

            for (int i = 0; i < cartelas.Length; i++)
            {
                if (cartelas[i] == null)
                {
                    cartelas[i] = c;
                    adicionou = true;
                    break;
                }
            }

            if (adicionou)
            {
                Console.WriteLine("Cartela adicionada.");
            }
            else
            {
                Console.WriteLine("Não há espaço para mais cartelas.");
            }
        }

        public void CriarCartelas(Random r)
        {
            for (int i = 0; i < cartelas.Length; i++)
            {
                cartelas[i] = new Cartelas();
                cartelas[i].PreencherCartela(r);
            }
        }

        public int QuantidadeCartelasAtivas()
        {
            int cont = 0;

            for (int i = 0; i < cartelas.Length; i++)
            {
                if (cartelas[i] != null)
                {
                    cont++;
                }
            }

            return cont;
        }
    }
}
